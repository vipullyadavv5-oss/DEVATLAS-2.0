# =============================================================================
# DEVATLAS 2.0 — FRONTEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this to .env.local and fill in values.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# NEVER put secrets here — only safe public values.
# =============================================================================

# URL of the Express backend server
# Development:
VITE_API_URL=http://localhost:5000

# Production example:
# VITE_API_URL=https://api.devatlas.dev
