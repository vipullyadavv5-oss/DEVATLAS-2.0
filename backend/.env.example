# =============================================================================
# DEVATLAS 2.0 — BACKEND ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to backend/.env and fill in the values.
# NEVER commit backend/.env to git.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── URLs ──────────────────────────────────────────────────────────────────────
# Frontend dev server (Vite default: 3000)
FRONTEND_URL=http://localhost:3000

# This backend server URL
BACKEND_URL=http://localhost:5000

# ── GitHub OAuth App ──────────────────────────────────────────────────────────
# Register at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL:        http://localhost:3000
# Authorization callback URL: http://localhost:5000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/callback

# ── Session ───────────────────────────────────────────────────────────────────
# Generate a strong random secret for production:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-strong-random-value-in-production
